# Telegram BotFather dan olingan bot tokeni
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Asosiy adminlarning Telegram ID raqamlari (vergul bilan ajrating, masalan: 123456789,987654321)
ADMIN_IDS=123456789

# Web server porti (Render.com o'zi avtomatik belgilaydi yoki 10000)
PORT=10000

# Server muhiti (development yoki production)
ENVIRONMENT=development
